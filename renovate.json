{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 3am"],
  "minimumReleaseAge": "3 days",
  "automerge": true,
  "automergeType": "pr",
  "semanticCommits": "enabled",
  "semanticCommitType": "deps",
  "semanticCommitScope": null,
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "minimumReleaseAge": "14 days"
    },
    {
      "matchUpdateTypes": ["minor"],
      "minimumReleaseAge": "7 days"
    },
    {
      "groupName": "react",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ]
    },
    {
      "groupName": "oxc",
      "matchPackageNames": ["oxlint", "oxfmt", "@oxlint/**", "oxc-*"]
    },
    {
      "groupName": "vite",
      "matchPackageNames": ["vite", "@vitejs/**", "vite-plugin-*", "vitest"]
    },
    {
      "groupName": "tailwind",
      "matchPackageNames": [
        "tailwindcss",
        "@tailwindcss/**",
        "postcss",
        "autoprefixer"
      ]
    },
    {
      "groupName": "testing",
      "matchPackageNames": ["@testing-library/**"]
    }
  ]
}
